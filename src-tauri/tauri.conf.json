{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Comic Studio",
  "version": "0.1.2",
  "identifier": "com.tsetch.aicomickstudio",
  "build": {
    "beforeDevCommand": "node server.js",
    "devUrl": "http://localhost:4321",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "AI Comic Studio",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
